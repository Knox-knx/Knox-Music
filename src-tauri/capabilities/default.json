{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "knox-capability",
  "description": "Minimal capability set: core window/IPC + opener (reveal data folder). No shell-exec, no global-shortcut, no tray in v1.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "knox-media:allow-sync",
    "knox-media:allow-clear",
    "knox-media:allow-status",
    "knox-media:allow-notification-state",
    "knox-media:allow-request-notification-permission",
    "knox-media:allow-open-app-settings",
    "knox-media:allow-request-battery-exemption"
  ]
}
