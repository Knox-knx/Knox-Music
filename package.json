{
  "name": "knox-music",
  "version": "1.0.3",
  "description": "KNOX Music — Your music, your device, your control. Local-first cross-platform music app.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "dev:core": "vitest run tests/unit/knox.test.ts",
    "dev:youtubemusic": "python3 services/youtubemusic/app.py --port 5000",
    "health": "node scripts/health.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:apk": "tauri android build --apk",
    "android:apk:debug": "tauri android build --debug --apk",
    "check:appimage": "node scripts/check-appimage-gst.mjs"
  },
  "keywords": [
    "music",
    "local-first",
    "offline",
    "pwa",
    "privacy"
  ],
  "author": "KNOX",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@vitejs/plugin-react": "^4.7.0",
    "dexie": "^4.4.5",
    "idb": "^8.0.3",
    "jsmediatags": "^3.9.7",
    "music-metadata-browser": "^2.5.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
