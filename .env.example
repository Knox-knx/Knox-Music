# KNOX Music — Public, Non-Secret Configuration Blueprint
# Copy to .env for local overrides. Never commit .env (it is git-ignored).
# Frontend code ships to the client and must never contain private secrets.

# ==============================================================================
# In-App Music Providers & Streaming APIs
# ==============================================================================

# JioSaavn API base URL (Default public endpoint)
JIOSAAVN_API_BASE_URL=https://www.jiosaavn.com/api.php
VITE_JIOSAAVN_API_BASE_URL=https://www.jiosaavn.com/api.php

# Spotify Web API base URL (Default public endpoint)
SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
VITE_SPOTIFY_API_BASE_URL=https://api.spotify.com/v1

# YouTube Music loopback sidecar base URL (Default local service port)
YOUTUBEMUSIC_API_BASE_URL=http://127.0.0.1:5000
VITE_YOUTUBEMUSIC_API_BASE_URL=http://127.0.0.1:5000

# ==============================================================================
# Radio & Synchronized Lyrics Services
# ==============================================================================

# Radio Browser API base URL (Public community radio database)
RADIO_BROWSER_API_BASE_URL=https://de1.api.radio-browser.info
VITE_RADIO_BROWSER_API_BASE_URL=https://de1.api.radio-browser.info

# LRCLIB synchronized lyrics base URL (Public timestamped lyrics database)
LRCLIB_API_BASE_URL=https://lrclib.net
VITE_LRCLIB_API_BASE_URL=https://lrclib.net

# ==============================================================================
# Network & Timeout Configuration
# ==============================================================================

# Per-provider search and stream resolution timeout budget (in milliseconds)
VITE_REQUEST_TIMEOUT_MS=15000
