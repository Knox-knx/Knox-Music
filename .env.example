# KNOX Music — public, non-secret configuration.
# Copy to .env for local overrides. Never commit .env (it is git-ignored).
# Never put the Jamendo Client Secret or any private token here — frontend
# code ships to the browser and must not contain secrets.

# Public Jamendo client_id (identifier only, safe for frontend use).
JAMENDO_CLIENT_ID=ecadb32a
VITE_JAMENDO_CLIENT_ID=ecadb32a

# API base URLs (defaults match these; override only for proxies/mirrors).
JAMENDO_API_BASE_URL=https://api.jamendo.com/v3.0
VITE_JAMENDO_API_BASE_URL=https://api.jamendo.com/v3.0

INTERNET_ARCHIVE_API_BASE_URL=https://archive.org
VITE_INTERNET_ARCHIVE_API_BASE_URL=https://archive.org

FREETOUSE_API_BASE_URL=https://api.freetouse.com/v3
# FreeToUse sends no CORS headers, so direct browser search always fails.
# The built-in Vite dev proxy (see vite.config.ts) avoids CORS entirely:
VITE_FREETOUSE_API_BASE_URL=/api/freetouse
# (Jamendo + Internet Archive already allow CORS, so they work direct.
# Optional proxies also exist: /api/jamendo, /api/archive — see vite.config.ts.)

# --- Desktop (Tauri) ---
# Production never uses .env — the host picks a free 127.0.0.1 port at launch
# and hands it plus a per-launch token to the renderer over IPC. These exist
# only for browser/PWA development against a manually started sidecar.
# YouTube Music sidecar base URL for browser dev (desktop uses its gateway).
YOUTUBEMUSIC_API_BASE_URL=http://127.0.0.1:5000
VITE_YOUTUBEMUSIC_API_BASE_URL=http://127.0.0.1:5000

# AirBeats catalog API (public, no key — full-length audio + metadata).
AIRBEATS_API_BASE_URL=https://api.airbeats.xyz
VITE_AIRBEATS_API_BASE_URL=https://api.airbeats.xyz

# --- Web Discovery search backend (OPTIONAL, genuine broad web search) ---
# Without this, Web Discovery uses catalog backends only (iTunes Search API
# + MusicBrainz/local desktop service) and labels rows honestly as catalog
# references — catalog lookup is never presented as broad web search.
# With this set, the operator's JSON backend supplies public-page hits:
#   GET {base}?q=<query> → { results: [{ url, title, snippet, domain }...] }
# Only the trimmed query string is ever sent. No scraping, no CAPTCHA/auth
# bypass — an unreachable backend yields an honest "unavailable" state.
# VITE_WEB_DISCOVERY_URL=https://search.example.com/knox
# Alias:
# VITE_WEB_SEARCH_URL=https://search.example.com/knox

# Do NOT create keys for Internet Archive or FreeToUse — they need none.
# Do NOT add JAMENDO_CLIENT_SECRET here.

# --- Audio diagnostics (DEVELOPMENT ONLY, never ship enabled) ---
# Bypass Smart Cache: provider URL straight to the element (direct path vs
# cache path comparison for §8 testing).
# KNOX_DIRECT_PROVIDER_PLAYBACK_DEBUG=true
# No-rebuild override (dev console):
#   localStorage['knox.dbg.directPlayback'] = '1' | '0'
